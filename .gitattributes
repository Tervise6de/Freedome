# Unity YAML assets merge with UnityYAMLMerge; mark them so Git does not try to
# be clever with them.
*.unity     -merge -text diff=unity
*.prefab    -merge -text diff=unity
*.asset     -merge -text diff=unity
*.mat       -merge -text diff=unity
*.meta      -merge -text diff=unity
*.controller -merge -text diff=unity

# Scripts and docs are normal text.
*.cs        text diff=csharp
*.md        text
*.json      text
*.shader    text
*.hlsl      text

# Binary art assets.
*.png       binary
*.jpg       binary
*.tga       binary
*.exr       binary
*.fbx       binary
*.wav       binary
*.ogg       binary
